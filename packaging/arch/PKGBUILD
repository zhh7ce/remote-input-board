# Maintainer: zhh7ce <zhh7ce@users.noreply.github.com>
#
# Rolling (-git) package built from THIS working tree rather than re-cloning
# GitHub: sources are copied out of the repository that contains this PKGBUILD,
# the same way fcitx5-text-injector's PKGBUILD does it. No network needed, and
# whatever is checked out here (including uncommitted edits) is what ships — so
# commit before building a package you intend to share.
#
# Build and install with:
#   cd packaging/arch && makepkg -si
#
# Runtime files follow XDG:
#   config:  ~/.config/remote-input-board  (pin.txt, trusted_devices.json, cert/key)
#   data:    ~/.local/share/remote-input-board  (logs, history)
pkgname=remote-input-board-git
_pkgname=remote-input-board
pkgver=r55.gb0fb227
pkgrel=1
pkgdesc="Use a phone browser as a remote text input panel for Linux (text via fcitx5-text-injector, Enter via wtype)"
arch=('any')
url="https://github.com/zhh7ce/${_pkgname}"
license=('custom')
# Text input needs the fcitx5-text-injector addon running inside fcitx5. It is
# not in any repository yet, so it is deliberately not in depends (installing
# this package would fail): build it from its own PKGBUILD and install it, then
# restart fcitx5. wtype stays a hard dependency because remote Enter needs a
# real key event, which commitString() cannot produce.
depends=('python' 'wtype')
optdepends=(
  'fcitx5-text-injector: commits the text to the focused app, immune to IME interference'
  'openssl: generate the self-signed HTTPS certificate (remote-input-board-generate-cert)'
  'systemd: run the server as a user service'
)
# git only backs pkgver() now — the sources themselves come from the work tree.
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=()
sha256sums=()

# packaging/arch -> repository root
_repo="$startdir/../.."

pkgver() {
  cd "$_repo"
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  local target="$srcdir/$_pkgname"
  # Wipe first: this path used to hold a GitHub clone and may still carry .git,
  # docs/ or an old dist/ that cp would happily leave behind.
  rm -rf "$target"
  mkdir -p "$target/packaging"
  cp -r "$_repo"/py_remote_input "$_repo"/tests "$_repo"/scripts \
        "$_repo"/pyproject.toml "$_repo"/README.md "$target"/
  cp -r "$_repo"/packaging/systemd "$target/packaging/"
  # A work-tree build sees the editor's leftovers; stale bytecode would ship
  # inside the wheel.
  find "$target" -name '__pycache__' -type d -exec rm -rf {} +
}

build() {
  cd "$srcdir/$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$_pkgname"
  python -m unittest discover -s tests
}

package() {
  cd "$srcdir/$_pkgname"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  # Helper CLI tools shipped from scripts/.
  install -Dm755 scripts/generate_cert.sh \
    "${pkgdir}/usr/bin/remote-input-board-generate-cert"

  # User service (not enabled by default):
  #   systemctl --user enable --now remote-input-board.service
  install -Dm644 packaging/systemd/remote-input-board.service \
    "${pkgdir}/usr/lib/systemd/user/remote-input-board.service"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
